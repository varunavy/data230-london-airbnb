      </column>
      <column caption='Size ' datatype='real' name='[Calculation_5260460500582409]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(CORR([accommodates], [Calculation_5260460367376386]))' />
      </column>
      <column caption='Host Profile' datatype='real' name='[Calculation_5260460509782028]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_5260460496310275] + ABS(CORR([hosts_time_as_host_years], [Calculation_5260460367376386]))) / 2' />
      </column>
      <column caption='Review Activity' datatype='real' name='[Calculation_5260460511043597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ABS(CORR([number_of_reviews], [Calculation_5260460367376386])) + ABS(CORR([number_of_reviews_ltm], [Calculation_5260460367376386])) + ABS(CORR([number_of_reviews_l30d], [Calculation_5260460367376386])) + ABS(CORR([reviews_per_month], [Calculation_5260460367376386]))) / 4' />
      </column>
      <column caption='Amenities Score' datatype='real' name='[Calculation_5260460511985678]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(CORR(LEN([amenities]) - LEN(REPLACE([amenities], &quot;,&quot;, &quot;&quot;)) + 1, [Calculation_5260460367376386]))' />
