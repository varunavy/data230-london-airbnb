      <aliases enabled='yes' />
      <column caption='Host Type' datatype='string' name='[Calculation_5260460358955008]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [calculated_host_listings_count] = 1 THEN &quot;1 listing&quot; ELSEIF [calculated_host_listings_count] &lt;= 5 THEN &quot;2-5 listings&quot; ELSE &quot;6+ listings&quot; END' />
      </column>
      <column caption='Listings' datatype='integer' name='[Calculation_5260460359299073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([id])' />
      </column>
      <column caption='Share of rated listings that are top-rated' datatype='integer' name='[Calculation_5260460367376386]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [review_scores_rating] &gt;= 4.8 THEN 1 ELSEIF [review_scores_rating] &gt; 0 THEN 0 END' />
      </column>
      <column caption='Host listings' datatype='real' name='[Calculation_5260460496310275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(CORR([calculated_host_listings_count], [Calculation_5260460367376386]))' />
      </column>
      <column caption='Reviews' datatype='real' name='[Calculation_5260460496617476]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(CORR([number_of_reviews], [Calculation_5260460367376386]))' />
      </column>
      <column caption='Days Available' datatype='real' name='[Calculation_5260460497219589]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(CORR([availability_365], [Calculation_5260460367376386]))' />
      </column>
      <column caption='Minimun Nights' datatype='real' name='[Calculation_5260460497346566]' role='measure' type='quantitative'>
